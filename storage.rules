rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    // REL Schedule Alert - 업로드한 원본 Reliability test plan Excel 파일.
    // 다른 사용자도 같은 파일을 내려받아 수정 후 재업로드할 수 있도록 signed-in(익명 로그인 포함)
    // 사용자에게 읽기/쓰기를 허용합니다.
    match /relScheduleFiles/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.size < 25 * 1024 * 1024; // 25MB 제한
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
