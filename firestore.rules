rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /mappingHistories/{historyId} {
      allow read, create, update, delete: if true;

      match /rowChunks/{chunkId} {
        allow read, create, update, delete: if true;
      }
    }

    match /yieldSummaryTapRaw/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasAll([
          'sod', 'sckInputLotNo', 'inQty', 'dedupeKey', 'uploadedAt'
        ])
        && request.resource.data.dedupeKey == docId;
      allow delete: if signedIn();
    }

    match /osComparisonRaw/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasAll([
          'inputDate', 'lotId', 'osInQty', 'dedupeKey', 'uploadedAt'
        ])
        && request.resource.data.dedupeKey == docId;
      allow delete: if signedIn();
    }

    match /binInformationRaw/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasAll([
          'reportMonth', 'lotId', 'inQty', 'dedupeKey', 'uploadedAt'
        ])
        && request.resource.data.dedupeKey == docId;
      allow delete: if signedIn();
    }

    match /mntCpkTrendRaw/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasAll([
          'reportMonth', 'product', 'item', 'dedupeKey', 'uploadedAt'
        ])
        && request.resource.data.dedupeKey == docId;
      allow delete: if signedIn();
    }

    match /relScheduleRaw/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasAll([
          'sheetName', 'criteria', 'relItem', 'dedupeKey', 'uploadedAt'
        ])
        && request.resource.data.dedupeKey == docId;
      allow delete: if signedIn();
    }

    match /relScheduleStatus/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasAll([
          'kind', 'dedupeKey', 'updatedAt'
        ])
        && request.resource.data.dedupeKey == docId;
      allow delete: if signedIn();
    }

    match /relScheduleFiles/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasAll([
          'fileName', 'downloadURL', 'uploadedAt'
        ]);
      allow delete: if signedIn();
    }
    // AI/BI immutable content variants; upload chunks before the manifest.
    match /aibiDocuments/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.kind in ['AI', 'BI']
        && request.resource.data.number is string && request.resource.data.number.size() > 0
        && request.resource.data.revision is string && request.resource.data.revision.size() > 0
        && request.resource.data.digest is string
        && request.resource.data.chunkCount is int && request.resource.data.chunkCount > 0;
      match /chunks/{chunkId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.keys().hasOnly(['index','data'])
          && request.resource.data.index is int && request.resource.data.index >= 0
          && request.resource.data.data is string && request.resource.data.data.size() <= 360000;
      }
    }
    match /qaIssueSummary/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.lot is string && request.resource.data.lot.size() > 0
        && request.resource.data.description is string && request.resource.data.description.size() > 0;
    }



    match /mntHoldLotEvents/{docId} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['event','lot'])
        && request.resource.data.event is string && request.resource.data.lot is string;
    }
    match /dailyTrackerVersions/{docId} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && request.resource.data.series is string
        && request.resource.data.digest is string && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount > 0;
      match /chunks/{chunkId} {
        allow read, delete: if signedIn();
        allow create, update: if signedIn() && request.resource.data.index is int
          && request.resource.data.data is string && request.resource.data.data.size() <= 360000;
      }
    }
    match /pcnHistories/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.historyKey is string
        && request.resource.data.changeFrom is string && request.resource.data.changeTo is string;
    }
    match /faRequestVersions/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.requestId is string
        && request.resource.data.digest is string && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount > 0 && request.resource.data.revision is int;
      match /chunks/{chunkId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.resource.data.index is int
          && request.resource.data.index >= 0 && request.resource.data.data is string
          && request.resource.data.data.size() <= 360000;
      }
    }




    match /{document=**} {
      allow read, write: if false;
    }
  }
}